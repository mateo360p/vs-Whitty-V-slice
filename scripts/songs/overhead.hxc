import flixel.FlxG;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.play.song.Song;

import Date;

class WhittyOverheadSong extends Song {
    var hasPlayedCutscene:Bool;
    public function new() {
        super('overhead');
    }

    function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);

        hasPlayedCutscene = false;
        discordRPC();
    }

    function onSongRetry(event:ScriptEvent) {
        super.onSongRetry(event);

        hasPlayedCutscene = true;
    }

    public function onCountdownStart(event:CountdownScriptEvent):Void {
        super.onCountdownStart(event);

        var isPico = (PlayState.instance.currentVariation == 'pico');

        if (!(PlayStatePlaylist.isStoryMode || isPico) || PlayState.instance.isChartingMode || hasPlayedCutscene) {
            return;
        }

        hasPlayedCutscene = true;
        event.cancel();
        startDialogue(isPico);
    }

    function startDialogue(isPico:Bool) {
        PlayState.instance.startConversation('overhead' + (isPico ? '-pico' : ''));
    }

    public override function onDialogueEnd() {
        Countdown.performCountdown();
    }

    // fkin adding 2 images to a discord lil window, amazing
    function discordRPC() {
        if (FlxG.onMobile || PlayState.instance == null) return;

        var daTime = Date.now().getTime();
        var daAlbum:String = PlayState.instance.currentChart.album;
        var daIcon:String = null;

        var dummyDad = PlayState.instance.currentStage.getDad();
        if (dummyDad != null) daIcon = dummyDad._data?.healthIcon?.id;

        if (daAlbum != null && daAlbum != "") PlayState.instance.discordRPCAlbum = "https://raw.githubusercontent.com/mateo360p/vs-Whitty-V-slice/refs/heads/Port-art/discord/albums/" + daAlbum + ".png?raw=true?t=" + daTime;
        if (daIcon != null && daIcon != "") PlayState.instance.discordRPCIcon = "https://raw.githubusercontent.com/mateo360p/vs-Whitty-V-slice/refs/heads/Port-art/discord/icons/" + daIcon + ".png?raw=true?t=" + daTime;
    }
}