import funkin.play.cutscene.dialogue.Conversation;
import funkin.audio.FunkinSound;

// so, yeah this got really smol
class BallisticConversation extends Conversation
{
    var whittySound:FunkinSound;
    var bfSound:FunkinSound;

    function new()
    {
        super('ballistic');
    }

    function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);
        whittySound = FunkinSound.load(Paths.sound('talkWhitty/ballisticTalk'), 0.6);
        bfSound = FunkinSound.load(Paths.sound('pixelText'), 0.6);
    }

    override function playSpeakerAnimation():Void
    {
        super.playSpeakerAnimation();
        var curSpeaker:String = currentSpeaker.id;
        var dummySound;
        switch(curSpeaker) {
            case "whitty":
                dummySound = whittySound;
            default: // bf or pico or smth else
                dummySound = bfSound;
        }

        // fkin dumbass-
        if(!currentDialogueBox.textDisplay.sounds.contains(dummySound))
        currentDialogueBox.textDisplay.sounds = [dummySound];
    }
}
